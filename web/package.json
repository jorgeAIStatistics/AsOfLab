{
  "name": "asoflab-web",
  "version": "0.1.0",
  "private": true,
  "description": "Inspection UI for AsOfLab. Reads the local read-only API; all data are synthetic.",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
