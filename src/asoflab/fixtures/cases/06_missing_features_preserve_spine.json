{
  "name": "missing_features_preserve_spine",
  "title": "A prediction with nothing eligible still gets a row",
  "invariant": "Missing features preserve prediction-spine cardinality.",
  "narrative": "p1 has one lactate. p2 has no events at all. Prediction C for p1 is at 07:00, before anything exists. All three predictions must appear in the output: a count of 0 and missing values, never a dropped row.",
  "day": "2025-03-01",
  "defaults": {
    "entity_id": "p1", "operation": "upsert", "source_revision": 1, "version_id": "v1",
    "event_type": "lab.lactate", "unit": "mmol/L", "source": "lis", "schema_version": "1",
    "source_availability_provenance": "observed", "pipeline_availability_provenance": "observed"
  },
  "features": [
    {"name": "lac_last_6h", "event_type": "lab.lactate", "aggregation": "last", "window": "6h"},
    {"name": "lac_count_6h", "event_type": "lab.lactate", "aggregation": "count", "window": "6h"},
    {"name": "lac_mean_6h", "event_type": "lab.lactate", "aggregation": "mean", "window": "6h"},
    {"name": "lac_since_6h", "event_type": "lab.lactate", "aggregation": "time_since_last", "window": "6h"}
  ],
  "events": [
    {"logical_event_id": "e1", "event_time": "08:00", "value": 3.3, "available": "08:05"}
  ],
  "spine": [
    {"prediction_id": "A", "entity_id": "p1", "prediction_time": "09:00"},
    {"prediction_id": "B", "entity_id": "p2", "prediction_time": "09:00"},
    {"prediction_id": "C", "entity_id": "p1", "prediction_time": "07:00"}
  ],
  "expected": {
    "pipeline_as_known": {
      "A": {"lac_last_6h": 3.3, "lac_count_6h": 1, "lac_mean_6h": 3.3, "lac_since_6h": 1.0},
      "B": {"lac_last_6h": null, "lac_count_6h": 0, "lac_mean_6h": null, "lac_since_6h": null},
      "C": {"lac_last_6h": null, "lac_count_6h": 0, "lac_mean_6h": null, "lac_since_6h": null}
    },
    "naive_event_time": {
      "A": {"lac_last_6h": 3.3, "lac_count_6h": 1, "lac_mean_6h": 3.3, "lac_since_6h": 1.0},
      "B": {"lac_last_6h": null, "lac_count_6h": 0, "lac_mean_6h": null, "lac_since_6h": null},
      "C": {"lac_last_6h": null, "lac_count_6h": 0, "lac_mean_6h": null, "lac_since_6h": null}
    }
  }
}
