{
  "name": "source_vs_pipeline",
  "title": "The source had it before the pipeline did",
  "invariant": "Source availability and pipeline availability are different clocks.",
  "narrative": "The lab system releases the result at 08:45. The model pipeline loads in batches and receives it at 09:15. A clinician looking at the lab system at 09:00 could see it; the deployed model could not. Which answer is right depends on which system is being replayed, so the policy has to say.",
  "day": "2025-03-01",
  "defaults": {
    "entity_id": "p1", "operation": "upsert", "source_revision": 1, "version_id": "v1",
    "event_type": "lab.lactate", "unit": "mmol/L", "source": "lis", "schema_version": "1",
    "source_availability_provenance": "observed", "pipeline_availability_provenance": "observed"
  },
  "features": [
    {"name": "lac_last_6h", "event_type": "lab.lactate", "aggregation": "last", "window": "6h"},
    {"name": "lac_count_6h", "event_type": "lab.lactate", "aggregation": "count", "window": "6h"},
    {"name": "lac_mean_6h", "event_type": "lab.lactate", "aggregation": "mean", "window": "6h"},
    {"name": "lac_since_6h", "event_type": "lab.lactate", "aggregation": "time_since_last", "window": "6h"}
  ],
  "events": [
    {"logical_event_id": "e1", "event_time": "08:00", "value": 2.2, "source_available_time": "08:45", "pipeline_available_time": "09:15"}
  ],
  "spine": [
    {"prediction_id": "A", "entity_id": "p1", "prediction_time": "09:00"},
    {"prediction_id": "B", "entity_id": "p1", "prediction_time": "09:15"}
  ],
  "expected": {
    "source_as_known": {
      "A": {"lac_last_6h": 2.2, "lac_count_6h": 1, "lac_mean_6h": 2.2, "lac_since_6h": 1.0},
      "B": {"lac_last_6h": 2.2, "lac_count_6h": 1, "lac_mean_6h": 2.2, "lac_since_6h": 1.25}
    },
    "pipeline_as_known": {
      "A": {"lac_last_6h": null, "lac_count_6h": 0, "lac_mean_6h": null, "lac_since_6h": null},
      "B": {"lac_last_6h": 2.2, "lac_count_6h": 1, "lac_mean_6h": 2.2, "lac_since_6h": 1.25}
    },
    "naive_event_time": {
      "A": {"lac_last_6h": 2.2, "lac_count_6h": 1, "lac_mean_6h": 2.2, "lac_since_6h": 1.0},
      "B": {"lac_last_6h": 2.2, "lac_count_6h": 1, "lac_mean_6h": 2.2, "lac_since_6h": 1.25}
    }
  }
}
