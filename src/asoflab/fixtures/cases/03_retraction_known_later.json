{
  "name": "retraction_known_later",
  "title": "A retraction applies only from the moment it is known",
  "invariant": "A retraction affects only cutoffs at which that retraction is known.",
  "narrative": "e1 (7.5 at 08:00) is released at 08:20 and withdrawn at 10:00 as a mislabelled sample. e2 (1.5 at 07:00) is unaffected. At 09:00 both are in force: last 7.5, mean (7.5 + 1.5) / 2 = 4.5. At 10:00 the retraction arrives first, leaving only e2. The naive policy has already deleted e1 for every cutoff, so it never shows the 7.5 that the 09:00 prediction actually used.",
  "day": "2025-03-01",
  "defaults": {
    "entity_id": "p1", "operation": "upsert", "source_revision": 1, "version_id": "v1",
    "event_type": "lab.lactate", "unit": "mmol/L", "source": "lis", "schema_version": "1",
    "source_availability_provenance": "observed", "pipeline_availability_provenance": "observed"
  },
  "features": [
    {"name": "lac_last_6h", "event_type": "lab.lactate", "aggregation": "last", "window": "6h"},
    {"name": "lac_count_6h", "event_type": "lab.lactate", "aggregation": "count", "window": "6h"},
    {"name": "lac_mean_6h", "event_type": "lab.lactate", "aggregation": "mean", "window": "6h"},
    {"name": "lac_since_6h", "event_type": "lab.lactate", "aggregation": "time_since_last", "window": "6h"}
  ],
  "events": [
