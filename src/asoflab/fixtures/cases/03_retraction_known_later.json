    {"logical_event_id": "e1", "version_id": "v2", "source_revision": 2, "operation": "retract", "available": "10:00"},
    {"logical_event_id": "e2", "event_time": "07:00", "value": 1.5, "available": "07:30"}
  ],
  "spine": [
    {"prediction_id": "A", "entity_id": "p1", "prediction_time": "09:00"},
    {"prediction_id": "B", "entity_id": "p1", "prediction_time": "10:00"},
    {"prediction_id": "C", "entity_id": "p1", "prediction_time": "11:00"}
  ],
  "expected": {
    "pipeline_as_known": {
      "A": {"lac_last_6h": 7.5, "lac_count_6h": 2, "lac_mean_6h": 4.5, "lac_since_6h": 1.0},
      "B": {"lac_last_6h": 1.5, "lac_count_6h": 1, "lac_mean_6h": 1.5, "lac_since_6h": 3.0},
      "C": {"lac_last_6h": 1.5, "lac_count_6h": 1, "lac_mean_6h": 1.5, "lac_since_6h": 4.0}
    },
    "latest_revised": {
      "A": {"lac_last_6h": 1.5, "lac_count_6h": 1, "lac_mean_6h": 1.5, "lac_since_6h": 2.0},
      "B": {"lac_last_6h": 1.5, "lac_count_6h": 1, "lac_mean_6h": 1.5, "lac_since_6h": 3.0},
      "C": {"lac_last_6h": 1.5, "lac_count_6h": 1, "lac_mean_6h": 1.5, "lac_since_6h": 4.0}
    },
    "naive_event_time": {
      "A": {"lac_last_6h": 1.5, "lac_count_6h": 1, "lac_mean_6h": 1.5, "lac_since_6h": 2.0},
      "B": {"lac_last_6h": 1.5, "lac_count_6h": 1, "lac_mean_6h": 1.5, "lac_since_6h": 3.0},
      "C": {"lac_last_6h": 1.5, "lac_count_6h": 1, "lac_mean_6h": 1.5, "lac_since_6h": 4.0}
