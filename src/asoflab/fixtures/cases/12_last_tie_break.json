{
  "name": "last_tie_break",
  "title": "Two observations at the same instant have a defined 'last'",
  "invariant": "Window boundaries and equal-time arrival/prediction ties match the contract.",
  "narrative": "e_a (1.0) and e_b (2.0) are both measured at 09:00. 'Last' must not depend on row order or on which engine ran, so the greater logical_event_id wins: e_b, 2.0.",
  "day": "2025-03-01",
  "defaults": {
    "entity_id": "p1", "operation": "upsert", "source_revision": 1, "version_id": "v1",
    "event_type": "lab.lactate", "unit": "mmol/L", "source": "lis", "schema_version": "1",
    "source_availability_provenance": "observed", "pipeline_availability_provenance": "observed"
  },
  "features": [
    {"name": "lac_last_6h", "event_type": "lab.lactate", "aggregation": "last", "window": "6h"},
    {"name": "lac_count_6h", "event_type": "lab.lactate", "aggregation": "count", "window": "6h"},
    {"name": "lac_mean_6h", "event_type": "lab.lactate", "aggregation": "mean", "window": "6h"},
    {"name": "lac_since_6h", "event_type": "lab.lactate", "aggregation": "time_since_last", "window": "6h"}
  ],
  "events": [
    {"logical_event_id": "e_b", "event_time": "09:00", "value": 2.0, "available": "09:10"},
    {"logical_event_id": "e_a", "event_time": "09:00", "value": 1.0, "available": "09:20"}
  ],
  "spine": [
    {"prediction_id": "A", "entity_id": "p1", "prediction_time": "10:00"}
  ],
  "expected": {
    "pipeline_as_known": {
      "A": {"lac_last_6h": 2.0, "lac_count_6h": 2, "lac_mean_6h": 1.5, "lac_since_6h": 1.0}
    },
    "naive_event_time": {
      "A": {"lac_last_6h": 2.0, "lac_count_6h": 2, "lac_mean_6h": 1.5, "lac_since_6h": 1.0}
    }
  }
}
