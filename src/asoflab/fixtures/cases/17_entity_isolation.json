{
  "name": "entity_isolation",
  "title": "One patient's data never reaches another patient's features",
  "invariant": "Features are scoped to one entity.",
  "narrative": "p1 has a lactate of 1.0 at 08:00 and p2 has 100.0 at 08:05. Each 09:00 prediction sees only its own patient's value. p2's value is 55 minutes old: 55 / 60 h.",
  "day": "2025-03-01",
  "defaults": {
    "entity_id": "p1", "operation": "upsert", "source_revision": 1, "version_id": "v1",
    "event_type": "lab.lactate", "unit": "mmol/L", "source": "lis", "schema_version": "1",
    "source_availability_provenance": "observed", "pipeline_availability_provenance": "observed"
  },
  "features": [
    {"name": "lac_last_6h", "event_type": "lab.lactate", "aggregation": "last", "window": "6h"},
    {"name": "lac_count_6h", "event_type": "lab.lactate", "aggregation": "count", "window": "6h"},
    {"name": "lac_mean_6h", "event_type": "lab.lactate", "aggregation": "mean", "window": "6h"},
    {"name": "lac_since_6h", "event_type": "lab.lactate", "aggregation": "time_since_last", "window": "6h"}
  ],
  "events": [
    {"entity_id": "p1", "logical_event_id": "e1", "event_time": "08:00", "value": 1.0, "available": "08:10"},
    {"entity_id": "p2", "logical_event_id": "e2", "event_time": "08:05", "value": 100.0, "available": "08:15"}
  ],
  "spine": [
    {"prediction_id": "A", "entity_id": "p1", "prediction_time": "09:00"},
    {"prediction_id": "B", "entity_id": "p2", "prediction_time": "09:00"}
  ],
  "expected": {
    "pipeline_as_known": {
      "A": {"lac_last_6h": 1.0, "lac_count_6h": 1, "lac_mean_6h": 1.0, "lac_since_6h": 1.0},
      "B": {"lac_last_6h": 100.0, "lac_count_6h": 1, "lac_mean_6h": 100.0, "lac_since_6h": 0.9166666666666666}
    },
    "naive_event_time": {
      "A": {"lac_last_6h": 1.0, "lac_count_6h": 1, "lac_mean_6h": 1.0, "lac_since_6h": 1.0},
      "B": {"lac_last_6h": 100.0, "lac_count_6h": 1, "lac_mean_6h": 100.0, "lac_since_6h": 0.9166666666666666}
    }
  }
}
