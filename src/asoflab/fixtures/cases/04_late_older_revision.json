{
  "name": "late_older_revision",
  "title": "An old revision delivered late does not win",
  "invariant": "A late older revision cannot overwrite a later source revision.",
  "narrative": "Revision 2 (3.0) reaches the pipeline at 08:30. Revision 1 (9.0) was delayed in a queue and arrives at 10:00. Source revision order decides, not arrival order, so 3.0 stays in force at 11:00 even though 9.0 arrived more recently.",
  "day": "2025-03-01",
  "defaults": {
    "entity_id": "p1", "operation": "upsert", "source_revision": 1, "version_id": "v1",
    "event_type": "lab.lactate", "unit": "mmol/L", "source": "lis", "schema_version": "1",
    "source_availability_provenance": "observed", "pipeline_availability_provenance": "observed"
  },
  "features": [
    {"name": "lac_last_6h", "event_type": "lab.lactate", "aggregation": "last", "window": "6h"},
    {"name": "lac_count_6h", "event_type": "lab.lactate", "aggregation": "count", "window": "6h"},
    {"name": "lac_mean_6h", "event_type": "lab.lactate", "aggregation": "mean", "window": "6h"},
    {"name": "lac_since_6h", "event_type": "lab.lactate", "aggregation": "time_since_last", "window": "6h"}
  ],
  "events": [
    {"logical_event_id": "e1", "version_id": "v2", "source_revision": 2, "event_time": "08:00", "value": 3.0, "available": "08:30"},
    {"logical_event_id": "e1", "version_id": "v1", "source_revision": 1, "event_time": "08:00", "value": 9.0, "available": "10:00"}
  ],
  "spine": [
    {"prediction_id": "A", "entity_id": "p1", "prediction_time": "09:00"},
    {"prediction_id": "B", "entity_id": "p1", "prediction_time": "11:00"}
  ],
  "expected": {
    "pipeline_as_known": {
      "A": {"lac_last_6h": 3.0, "lac_count_6h": 1, "lac_mean_6h": 3.0, "lac_since_6h": 1.0},
      "B": {"lac_last_6h": 3.0, "lac_count_6h": 1, "lac_mean_6h": 3.0, "lac_since_6h": 3.0}
    },
    "naive_event_time": {
      "A": {"lac_last_6h": 3.0, "lac_count_6h": 1, "lac_mean_6h": 3.0, "lac_since_6h": 1.0},
      "B": {"lac_last_6h": 3.0, "lac_count_6h": 1, "lac_mean_6h": 3.0, "lac_since_6h": 3.0}
    }
  }
}
