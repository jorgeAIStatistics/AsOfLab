{
  "name": "stale_revision_after_expiry",
  "title": "A stale revision cannot resurrect a withdrawn or expired observation",
  "invariant": "A late older revision cannot overwrite a later source revision.",
  "narrative": "e1 is retracted (revision 2, known 08:10) and e3's revision 2 (2.0 at 08:00) is known at 08:10. Twelve hours later, long after both have aged out of every window, their revision 1 records finally turn up at 20:30 carrying recent event times (19:30 and 19:45). They are lower revisions, so nothing changes: e1 stays withdrawn and e3 stays at 08:00, outside the 21:00 window. An engine that discards its memory of a logical event once the value has expired or been retracted would treat these as new observations. At 09:00, e2 and e3 are both measured at 08:00, so 'last' is e3 by the tie rule.",
  "day": "2025-03-01",
  "defaults": {
    "entity_id": "p1", "operation": "upsert", "source_revision": 1, "version_id": "v1",
    "event_type": "lab.lactate", "unit": "mmol/L", "source": "lis", "schema_version": "1",
    "source_availability_provenance": "observed", "pipeline_availability_provenance": "observed"
  },
  "features": [
    {"name": "lac_last_6h", "event_type": "lab.lactate", "aggregation": "last", "window": "6h"},
    {"name": "lac_count_6h", "event_type": "lab.lactate", "aggregation": "count", "window": "6h"},
    {"name": "lac_mean_6h", "event_type": "lab.lactate", "aggregation": "mean", "window": "6h"},
    {"name": "lac_since_6h", "event_type": "lab.lactate", "aggregation": "time_since_last", "window": "6h"}
  ],
  "events": [
    {"logical_event_id": "e1", "version_id": "v2", "source_revision": 2, "operation": "retract", "available": "08:10"},
    {"logical_event_id": "e1", "version_id": "v1", "source_revision": 1, "event_time": "19:30", "value": 9.0, "available": "20:30"},
    {"logical_event_id": "e2", "event_time": "08:00", "value": 1.0, "available": "08:05"},
    {"logical_event_id": "e3", "version_id": "v2", "source_revision": 2, "event_time": "08:00", "value": 2.0, "available": "08:10"},
    {"logical_event_id": "e3", "version_id": "v1", "source_revision": 1, "event_time": "19:45", "value": 7.0, "available": "20:30"}
  ],
  "spine": [
