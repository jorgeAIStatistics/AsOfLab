      "A": {"lac_last_6h": 2.0, "lac_count_6h": 2, "lac_mean_6h": 1.5, "lac_since_6h": 1.0},
      "B": {"lac_last_6h": null, "lac_count_6h": 0, "lac_mean_6h": null, "lac_since_6h": null},
      "C": {"lac_last_6h": null, "lac_count_6h": 0, "lac_mean_6h": null, "lac_since_6h": null}
    },
    "latest_revised": {
      "A": {"lac_last_6h": 2.0, "lac_count_6h": 2, "lac_mean_6h": 1.5, "lac_since_6h": 1.0},
      "B": {"lac_last_6h": null, "lac_count_6h": 0, "lac_mean_6h": null, "lac_since_6h": null},
      "C": {"lac_last_6h": null, "lac_count_6h": 0, "lac_mean_6h": null, "lac_since_6h": null}
