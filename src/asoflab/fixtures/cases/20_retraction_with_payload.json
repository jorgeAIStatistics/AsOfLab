{
  "name": "retraction_with_payload",
  "title": "A retraction that still carries the old value contributes nothing",
  "invariant": "A retraction affects only cutoffs at which that retraction is known.",
  "narrative": "Some feeds send a delete record that repeats the withdrawn observation's time and value. e1 (7.0 at 08:00) is retracted at 08:50 by such a record. At 09:00 the retraction is in force, so only e2 (3.0 at 08:30) counts. An implementation that forgets to check the operation would read the 7.0 carried on the retraction row.",
  "day": "2025-03-01",
  "defaults": {
    "entity_id": "p1", "operation": "upsert", "source_revision": 1, "version_id": "v1",
    "event_type": "lab.lactate", "unit": "mmol/L", "source": "lis", "schema_version": "1",
    "source_availability_provenance": "observed", "pipeline_availability_provenance": "observed"
  },
  "features": [
    {"name": "lac_last_6h", "event_type": "lab.lactate", "aggregation": "last", "window": "6h"},
    {"name": "lac_count_6h", "event_type": "lab.lactate", "aggregation": "count", "window": "6h"},
    {"name": "lac_mean_6h", "event_type": "lab.lactate", "aggregation": "mean", "window": "6h"},
    {"name": "lac_since_6h", "event_type": "lab.lactate", "aggregation": "time_since_last", "window": "6h"}
  ],
  "events": [
    {"logical_event_id": "e1", "version_id": "v1", "source_revision": 1, "event_time": "08:00", "value": 7.0, "available": "08:10"},
    {"logical_event_id": "e1", "version_id": "v2", "source_revision": 2, "operation": "retract", "event_time": "08:45", "value": 7.0, "available": "08:50"},
    {"logical_event_id": "e2", "event_time": "08:30", "value": 3.0, "available": "08:35"}
  ],
  "spine": [
    {"prediction_id": "A", "entity_id": "p1", "prediction_time": "08:40"},
    {"prediction_id": "B", "entity_id": "p1", "prediction_time": "09:00"}
  ],
  "expected": {
    "pipeline_as_known": {
      "A": {"lac_last_6h": 3.0, "lac_count_6h": 2, "lac_mean_6h": 5.0, "lac_since_6h": 0.16666666666666666},
      "B": {"lac_last_6h": 3.0, "lac_count_6h": 1, "lac_mean_6h": 3.0, "lac_since_6h": 0.5}
    },
    "latest_revised": {
      "A": {"lac_last_6h": 3.0, "lac_count_6h": 1, "lac_mean_6h": 3.0, "lac_since_6h": 0.16666666666666666},
      "B": {"lac_last_6h": 3.0, "lac_count_6h": 1, "lac_mean_6h": 3.0, "lac_since_6h": 0.5}
    },
    "naive_event_time": {
      "A": {"lac_last_6h": 3.0, "lac_count_6h": 1, "lac_mean_6h": 3.0, "lac_since_6h": 0.16666666666666666},
      "B": {"lac_last_6h": 3.0, "lac_count_6h": 1, "lac_mean_6h": 3.0, "lac_since_6h": 0.5}
    }
  }
}
